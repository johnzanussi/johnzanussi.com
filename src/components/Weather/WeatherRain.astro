---
import type { Weather } from '@/utils/weather';

interface Props extends Omit<WeatherMetricProps, 'title'> {
    weather: Weather;
};

import UnitValue from '@/components/Weather/UnitValue.astro';
import WeatherDial from '@/components/Weather/WeatherDial.astro';
import WeatherMetric, { type Props as WeatherMetricProps } from '@/components/Weather/WeatherMetric.astro';
import { UNITS } from '@/utils/weather';

const {
    weather,
    ...props
} = Astro.props;

// Three rows of three streaks; the middle row is nudged right so they don't line up
const streaks = [10, 29, 48].flatMap((y, row) => [20, 34, 48].map((x) => ({
    x: x + (row === 1 ? 7 : 0),
    y,
})));

// Streaks light up from the top as today's rain adds up; any rain lights at least one
const lit = weather.rainPercent ? Math.max(1, Math.round(weather.rainPercent / 100 * streaks.length)) : 0;
---
<WeatherMetric title="Rain" {...props}>

    <WeatherDial class="relative overflow-hidden">
        <svg
            viewBox="0 0 68 68"
            class:list={['absolute inset-0 size-full', { 'rain-streaks-falling': weather.raining }]}
            role="img"
            aria-label={weather.raining ? 'Raining' : 'Not raining'}
        >
            {streaks.map(({ x, y }, index) => (
                <line
                    x1={x}
                    y1={y}
                    x2={x - 6}
                    y2={y + 13}
                    stroke-width="2.5"
                    stroke-linecap="round"
                    class:list={[index < lit ? 'stroke-rain rain-streak-lit' : 'stroke-zinc-300 dark:stroke-gray-700']}
                    style={{ '--delay': `${index * -0.13}s` }}
                />
            ))}
        </svg>
    </WeatherDial>

    <Fragment slot="value">
        <UnitValue value={weather.rainToday} /> <UnitValue value={UNITS.rain} />
    </Fragment>

    <Fragment slot="note">
        <UnitValue value={weather.rainRate} />
    </Fragment>

</WeatherMetric>

<style is:inline>
    @keyframes rain-streak-fall {
        from {
            opacity: 0;
            transform: translate(3px, -6px);
        }
        40% {
            opacity: 1;
        }
        to {
            opacity: 0;
            transform: translate(-3px, 6px);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .rain-streaks-falling .rain-streak-lit {
            animation: rain-streak-fall 1.1s linear infinite;
            animation-delay: var(--delay);
        }
    }
</style>
