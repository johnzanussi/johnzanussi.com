---
import Icon from '@/components/Icon.astro';

export type Props = {
    align?: 'left' | 'center' | 'right';
    caption?: string;
    class?: string;
};

const {
    align = 'center',
    caption,
    class: className,
} = Astro.props;

const alignClasses = {
    'left': 'text-start',
    'center': 'text-center',
    'right': 'text-end',
};

const alignClass = alignClasses[align];

---
<figure
    class:list={[
        'inline-block mb-6',
        className,
    ]}
>

    <slot />

    <figcaption class="mt-2">

        {caption && (
            <p class:list={['italic text-zinc-600 dark:text-zinc-400 text-center mb-0 text-sm', alignClass]}>
                <Icon icon="tabler:photo" />
                {caption}
            </p>
        )}

        <slot name="caption" />

    </figcaption>

</figure>
