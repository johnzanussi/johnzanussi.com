---
import type { ImageMetadata } from 'astro';
import { Image as AstroImage, Picture } from 'astro:assets';
import { IMAGE_PRESETS } from '@/utils/images';

const { src, alt, ...props } = Astro.props;

const rawAlt = alt ?? '';
const isUnwrapped = /\s?\{?noDivWrap\}?$/.test(rawAlt);
const altText = rawAlt.replace(/\s?\{?noDivWrap\}?$/, '').trim();

const contentPreset = IMAGE_PRESETS.content;
const imageSrc = src as ImageMetadata;
// Animated GIFs: use Image→WebP (Sharp preserves animation) instead of
// Picture/AVIF, which can drop frames or balloon file size.
const isAnimatedGif = imageSrc?.format === 'gif';
const imageClass = 'max-w-full h-auto';
---

{isUnwrapped ? (
    isAnimatedGif ? (
        <AstroImage
            src={imageSrc}
            alt={altText}
            class={imageClass}
            format="webp"
            loading="lazy"
            {...props}
        />
    ) : (
        <Picture
            src={imageSrc}
            alt={altText}
            class={imageClass}
            formats={[...contentPreset.formats]}
            widths={[...contentPreset.widths]}
            sizes={contentPreset.sizes}
            quality={contentPreset.quality}
            loading="lazy"
            {...props}
        />
    )
) : (
    <div class="mb-6">
        {isAnimatedGif ? (
            <AstroImage
                src={imageSrc}
                alt={altText}
                class={imageClass}
                format="webp"
                loading="lazy"
                {...props}
            />
        ) : (
            <Picture
                src={imageSrc}
                alt={altText}
                class={imageClass}
                formats={[...contentPreset.formats]}
                widths={[...contentPreset.widths]}
                sizes={contentPreset.sizes}
                quality={contentPreset.quality}
                loading="lazy"
                {...props}
            />
        )}
    </div>
)}
