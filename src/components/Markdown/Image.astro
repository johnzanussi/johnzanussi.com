---
import type { ImageMetadata } from 'astro';
import { Image as AstroImage, Picture } from 'astro:assets';
import { IMAGE_PRESETS } from '@/utils/images';

// Extra attributes come from the markdown, e.g. ![alt](src)(class: "w-40", unwrap: true)
const { src, alt, class: customClass, unwrap, ...props } = Astro.props;

const isUnwrapped = Boolean(customClass || unwrap);
const altText = alt ?? '';

const contentPreset = IMAGE_PRESETS.content;
const imageSrc = src as ImageMetadata;
// Animated GIFs: use Image→WebP (Sharp preserves animation) instead of
// Picture/AVIF, which can drop frames or balloon file size.
const isAnimatedGif = imageSrc?.format === 'gif';
const imageClass = customClass ? `block max-w-full h-auto ${customClass}` : 'max-w-full h-auto';
const pictureAttributes = customClass ? { class: 'contents' } : {};
---

{isUnwrapped ? (
    isAnimatedGif ? (
        <AstroImage
            src={imageSrc}
            alt={altText}
            class={imageClass}
            format="webp"
            loading="lazy"
            {...props}
        />
    ) : (
        <Picture
            src={imageSrc}
            alt={altText}
            class={imageClass}
            pictureAttributes={pictureAttributes}
            formats={[...contentPreset.formats]}
            fallbackFormat={contentPreset.fallbackFormat}
            widths={[...contentPreset.widths]}
            sizes={contentPreset.sizes}
            quality={contentPreset.quality}
            loading="lazy"
            {...props}
        />
    )
) : (
    <div class="mb-6">
        {isAnimatedGif ? (
            <AstroImage
                src={imageSrc}
                alt={altText}
                class={imageClass}
                format="webp"
                loading="lazy"
                {...props}
            />
        ) : (
            <Picture
                src={imageSrc}
                alt={altText}
                class={imageClass}
                formats={[...contentPreset.formats]}
                fallbackFormat={contentPreset.fallbackFormat}
                widths={[...contentPreset.widths]}
                sizes={contentPreset.sizes}
                quality={contentPreset.quality}
                loading="lazy"
                {...props}
            />
        )}
    </div>
)}
