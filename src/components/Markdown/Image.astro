---
import { Picture } from 'astro:assets';

const { src, alt, ...props } = Astro.props;

const [altText, noDivWrap = false] = alt ? alt.split(' noDivWrap') : [alt];

const isUnwrapped = noDivWrap === '';

const widths = [576, 768, 992, 1200, 1400, 1600];
const sizes = '(min-width: 1200px) 720px, (min-width: 780px) calc(100vw - 371px), calc(100vw - 32px)';
---

{isUnwrapped && (
    <Picture
        src={src}
        alt={altText}
        class="img-fluid"
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading="lazy"
        {...props}
    />
)}

{!isUnwrapped && (

    <div class="mb-6">
        <Picture
            src={src}
            alt={altText}
            class="img-fluid"
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            loading="lazy"
            {...props}
        />
    </div>

)}
