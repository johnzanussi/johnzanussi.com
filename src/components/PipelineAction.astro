---
type Props = {
    mode: 'push' | 'pull';
    title: string;
    class?: string;
};

const {
    mode,
    title,
    class: className,
} = Astro.props;

const hasBody = Astro.slots.has('default');

// Two lines angle out from the spine and back in, bracketing the action
const connectors = [
    { position: 'top-0', path: 'M20 0 L40 100' },
    { position: 'bottom-0', path: 'M40 0 L20 100' },
];
---
<li
    class:list={[
        'relative my-0 ps-14 pb-6',
        className,
    ]}
>

    <div class="absolute left-5 bottom-0 h-6 w-px -translate-x-1/2 bg-zinc-300 dark:bg-gray-700" />

    <div class="relative py-2">

        {connectors.map(({ position, path }) => (
            <svg
                class:list={['absolute -left-14 w-14 h-1/2 overflow-visible text-zinc-300 dark:text-gray-700', position]}
                viewBox="0 0 56 100"
                preserveAspectRatio="none"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d={path}
                    stroke="currentColor"
                    vector-effect="non-scaling-stroke"
                />
            </svg>
        ))}

        <div class="relative w-fit max-w-full px-6 py-3 rounded-xl bg-violet-500/5">

            <span class="absolute -left-8 top-1/2 -translate-y-1/2 flex items-center justify-center w-12 h-6 rounded-lg border bg-white border-zinc-200 dark:bg-[#0E1215] dark:border-gray-800 text-[0.625rem] font-bold uppercase leading-none text-violet-700 dark:text-violet-300/80">
                {mode}
            </span>

            <div class="font-medium leading-6 text-violet-800/90 dark:text-violet-200/80">
                {title}
            </div>

            {hasBody && (
                <div class="mt-0.5 *:first:mt-0! *:last:mb-0!">
                    <slot />
                </div>
            )}

        </div>

    </div>

</li>
