{
    "name": "johnzanussi.com",
    "description": "My personal website located at johnzanussi.com",
    "version": "4.1.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johnzanussi/johnzanussi.com.git"
    },
    "author": "John Zanussi",
    "license": "GPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/johnzanussi/johnzanussi.com/issues"
    },
    "homepage": "https://johnzanussi.com",
    "private": true,
    "packageManager": "pnpm@10.12.1",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "check": "astro check",
        "astro": "astro",
        "prepare": "husky",
        "update": "pnpm dlx npm-check-updates",
        "youtube": "pnpm dlx ts-node --esm lib/youtube/youtube.mts",
        "ts": "tsc --noEmit",
        "lint": "eslint --cache src/**/*.{astro,ts}",
        "lint:fix": "eslint --cache --fix src/**/*.{astro,ts}"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp"
        ],
        "overrides": {
            "postcss-selector-parser": "^7.1.6"
        }
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/markdown-satteri": "^0.4.4",
        "@astrojs/mdx": "^8.1.0",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@astrojs/vercel": "^11.0.15",
        "@expressive-code/plugin-collapsible-sections": "^0.44.2",
        "@expressive-code/plugin-line-numbers": "^0.44.2",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/tabler": "^1.2.42",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.4.0",
        "astro-expressive-code": "^0.44.2",
        "astro-icon": "^1.2.0",
        "date-fns": "^4.4.0",
        "debounce": "^3.0.0",
        "deepmerge": "^4.3.1",
        "metatags-generator": "^1.1.8",
        "reading-time": "^1.5.0",
        "satteri": "^0.10.5",
        "satteri-imgattr": "0.1.1",
        "satteri-mathml": "^0.1.1",
        "simple-scrollspy": "^2.5.3",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@types/debounce": "^1.2.4",
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "astro-eslint-parser": "^3.2.0",
        "astro-robots-txt": "^1.0.0",
        "eslint": "^10.13.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "fastcomments-typescript": "^3.0.17",
        "gemoji": "^8.1.0",
        "github-slugger": "^2.0.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "intersection-observer-debugger": "^0.1.1",
        "lint-staged": "^17.6.0",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.5"
    },
    "lint-staged": {
        "*.{astro,js,ts}": "eslint --cache --fix",
        "*.{gif,jpg,jpeg,png}": "node ./lib/compress-images.mjs"
    }
}
